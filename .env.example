# SmartDine SaaS Environment Configuration
# When connecting MongoDB Atlas on Vercel via Vercel Marketplace / Storage, 
# Vercel will automatically inject MONGODB_URI into your production environment!

# MongoDB Atlas URI (Auto-provided by Vercel Integration or Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartdine?retryWrites=true&w=majority

# App Base URL
NEXT_PUBLIC_APP_URL=https://your-smartdine-app.vercel.app

# Optional Sandbox Payment Credentials (for live verification)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
EASYPAISA_STORE_ID=
